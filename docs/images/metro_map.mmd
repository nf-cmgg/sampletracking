%%metro title: nf-cmgg/sampletracking
%%metro diamond_style: symmetric
%%metro file: SNP | BAM/CRAM | SNP
%%metro file: SAMPLE | BAM/CRAM | SAMPLE
%%metro file: MULTIQC | HTML | MultiQC

graph LR
    SNP[snp]
    SAMPLE[sample]
    SAMTOOLS_DEPTH[samtools depth]
    NBSBIT_SAMPLEGENDER[ngs-bits samplegender]
    PICARD_CROSSCHECKFINGERPRINTS[picard crosscheckFingerprints]
