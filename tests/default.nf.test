nextflow_workflow {

    name "Test Workflow SAMPLETRACKING"
    script "workflows/sampletracking.nf"

    tag "workflows"
    tag "workflows/sampletracking"

    workflow "SAMPLETRACKING"

    test("Should run without failures") {
        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = Channel.of(
                    [
                        [id:"sample1", pool: "pool1", pool_count:2],
                        file("${params.pipelines_testdata_base_path}/sample1.cram"),
                        file("${params.pipelines_testdata_base_path}/sample1.cram.crai"),
                        file("${params.pipelines_testdata_base_path}/snp_sample1.cram"),
                        file("${params.pipelines_testdata_base_path}/snp_sample1.cram.crai"),
                    ],
                    [
                        [id:"sample2", pool: "pool1", pool_count:2],
                        file("${params.pipelines_testdata_base_path}/sample2.cram"),
                        file("${params.pipelines_testdata_base_path}/sample2.cram.crai"),
                        file("${params.pipelines_testdata_base_path}/snp_sample2.cram"),
                        file("${params.pipelines_testdata_base_path}/snp_sample2.cram.crai"),
                    ],
                )
                input[1] = Channel.value(
                    [
                        [:],
                        file("${params.pipelines_testdata_base_path}/GCA_000001405.15_GRCh38_full_plus_hs38d1_analysis_set_chr21.fna"),
                        file("${params.pipelines_testdata_base_path}/GCA_000001405.15_GRCh38_full_plus_hs38d1_analysis_set_chr21.fna.fai")
                    ]
                )
                input[2] = Channel.value(
                    [
                        [:],
                        file("${params.pipelines_testdata_base_path}/haplotype_map.txt")
                    ]
                )
                input[3] = file("${outputDir}")
                input[4] = []
                input[5] = []
                input[6] = []
                """
            }
        }

        then {
            // stable_path: All files + folders in ${params.outdir}/ with a stable path (including file name)
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{mmd,html,json,txt}'])
            // stable_content: All files in ${params.outdir}/ with stable content
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assert workflow.success
            assertAll(
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/sampletracking_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_path,
                    // All files with stable contents
                    stable_content
                ).match() }
            )
        }
    }

    test("Should run without failures - skip crosscheck fingerprints") {
        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = Channel.of(
                    [
                        [id:"sample1", pool: "pool1", pool_count:2],
                        file("${params.pipelines_testdata_base_path}/sample1.cram"),
                        file("${params.pipelines_testdata_base_path}/sample1.cram.crai"),
                        [],
                        []
                    ],
                    [
                        [id:"sample2", pool: "pool1", pool_count:2],
                        file("${params.pipelines_testdata_base_path}/sample2.cram"),
                        file("${params.pipelines_testdata_base_path}/sample2.cram.crai"),
                        file("${params.pipelines_testdata_base_path}/snp_sample2.cram"),
                        file("${params.pipelines_testdata_base_path}/snp_sample2.cram.crai"),
                    ],
                )
                input[1] = Channel.value(
                    [
                        [:],
                        file("${params.pipelines_testdata_base_path}/GCA_000001405.15_GRCh38_full_plus_hs38d1_analysis_set.fna"),
                        file("${params.pipelines_testdata_base_path}/GCA_000001405.15_GRCh38_full_plus_hs38d1_analysis_set.fna.fai")
                    ]
                )
                input[2] = Channel.value(
                    [
                        [id: "haplotype_map"],
                        file("${params.pipelines_testdata_base_path}/haplotype_map.txt")
                    ]
                )
                input[3] = file("${outputDir}")
                input[4] = []
                input[5] = []
                input[6] = []
                """
            }
        }

        then {
            // stable_path: All files + folders in ${params.outdir}/ with a stable path (including file name)
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{mmd,html,json,txt}'])
            // stable_content: All files in ${params.outdir}/ with stable content
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assert workflow.success
            assertAll(
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/sampletracking_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_path,
                    // All files with stable contents
                    stable_content
                ).match() }
            )
        }
    }
}
